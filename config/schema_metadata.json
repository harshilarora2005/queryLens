  "few_shot_examples": [
    {
      "question": "What was total revenue by month in 2023 for completed orders?",
      "sql": "SELECT DATE_TRUNC(DATE(o.created_at), MONTH) AS month, SUM(oi.sale_price) AS revenue FROM `bigquery-public-data.thelook_ecommerce.orders` o JOIN `bigquery-public-data.thelook_ecommerce.order_items` oi USING(order_id) WHERE o.status = 'Complete' AND EXTRACT(YEAR FROM o.created_at) = 2023 GROUP BY month ORDER BY month;"
    },
    {
      "question": "Top 10 products by revenue last 30 days",
      "sql": "SELECT p.name, SUM(oi.sale_price) AS revenue FROM `bigquery-public-data.thelook_ecommerce.order_items` oi JOIN `bigquery-public-data.thelook_ecommerce.products` p ON p.id = oi.product_id WHERE oi.created_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY) GROUP BY p.name ORDER BY revenue DESC LIMIT 10;"
    },
    {
      "question": "How many orders were returned in Q1 2024 by country?",
      "sql": "SELECT u.country, COUNT(*) AS returned_orders FROM `bigquery-public-data.thelook_ecommerce.orders` o JOIN `bigquery-public-data.thelook_ecommerce.users` u ON u.id = o.user_id WHERE o.status = 'Returned' AND DATE(o.returned_at) BETWEEN '2024-01-01' AND '2024-03-31' GROUP BY u.country ORDER BY returned_orders DESC;"
    }
  ]
